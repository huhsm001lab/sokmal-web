# SOKMAL 환경변수 예시. 복사해서 .env.local 로 쓰고(로컬), Vercel 에서는 Settings > Environment Variables 에 넣어요.
# .env.local 은 git 에 올리지 않아요.

# ---------- AI (Anthropic) ----------
ANTHROPIC_API_KEY=
# 모델 [기본안] — 블라인드 비교 후 확정. 질문 만들기(가벼운 호출)만 LIGHT 를 써요
MODEL_MAIN=claude-sonnet-5-5
MODEL_LIGHT=claude-haiku-5-5
# 생각 깊이 [기본안]: low / medium / high
EFFORT_MAIN=medium
EFFORT_LIGHT=low

# ---------- 월 예산 상한 ----------
# [미정] 금액은 송무 결정. 기획 제안은 200000(월 20만 원). 비어 있으면 AI를 돌리지 않아요(안전장치)
MONTHLY_BUDGET_KRW=
# 비용을 원화로 셀 때 쓰는 환율(원/달러). 비어 있으면 AI를 돌리지 않아요. 가끔 실제 환율로 고쳐 주세요
USD_KRW=

# ---------- Supabase (사용자 구분 + 횟수·비용 기록) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 비밀 키. 절대 NEXT_PUBLIC_ 을 붙이지 않아요
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 개발·테스트용 (운영에서는 비워 둠) ----------
# 1 이면 AI를 부르지 않고 정해 둔 가짜 답을 흘려보내요
MOCK_AI=
# 1 이면 Supabase 없이 기기 아이디로 사용자를 구분하고 메모리에 기록해요(서버를 끄면 사라짐)
SOKMAL_DEV_AUTH=
