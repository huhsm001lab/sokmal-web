# SOKMAL 환경변수 예시. 복사해서 .env.local 로 쓰고(로컬), Vercel 에서는 Settings > Environment Variables 에 넣어요.
# .env.local 은 git 에 올리지 않아요.

# ---------- AI 회사 ----------
# openai | anthropic. 비워 두면 OPENAI_API_KEY 가 있으면 openai (11-27 송무 결정: OpenAI 사용)
AI_PROVIDER=

# ---------- AI (OpenAI) ----------
OPENAI_API_KEY=
# 모델 이름은 OpenAI 모델 목록에 있는 그대로 (필수)
OPENAI_MODEL=
# (선택) 쓰기 전 질문 만들기용 가벼운 모델. 비우면 OPENAI_MODEL
OPENAI_MODEL_LIGHT=
# (선택) 생각 깊이. 모델이 지원할 때만: none / minimal / low / medium / high
OPENAI_REASONING_EFFORT=
# (선택) 100만 토큰당 달러. 셋 다 넣고 MONTHLY_BUDGET_KRW·USD_KRW 도 넣으면 앱이 비용을 세고 상한에서 멈춰요.
# 비우면 비용 천장은 OpenAI 대시보드의 예산 한도예요(꼭 걸어 두세요).
OPENAI_PRICE_INPUT=
OPENAI_PRICE_CACHED_INPUT=
OPENAI_PRICE_OUTPUT=

# ---------- AI (Anthropic, 예전 설정) ----------
ANTHROPIC_API_KEY=
# 모델 [기본안] — 블라인드 비교 후 확정. 질문 만들기(가벼운 호출)만 LIGHT 를 써요
MODEL_MAIN=claude-sonnet-5-5
MODEL_LIGHT=claude-haiku-5-5
# 생각 깊이 [기본안]: low / medium / high
EFFORT_MAIN=medium
EFFORT_LIGHT=low

# ---------- 월 예산 상한 ----------
# [미정] 금액은 송무 결정. 기획 제안은 200000(월 20만 원).
# Anthropic: 비어 있으면 AI를 돌리지 않아요(안전장치). OpenAI: 선택(위 가격 3개와 함께 넣을 때만 앱이 셈)
MONTHLY_BUDGET_KRW=
# 비용을 원화로 셀 때 쓰는 환율(원/달러). 비어 있으면 AI를 돌리지 않아요. 가끔 실제 환율로 고쳐 주세요
USD_KRW=

# ---------- Supabase (사용자 구분 + 횟수·비용 기록) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 비밀 키. 절대 NEXT_PUBLIC_ 을 붙이지 않아요
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 개발·테스트용 (운영에서는 비워 둠) ----------
# 1 이면 AI를 부르지 않고 정해 둔 가짜 답을 흘려보내요
MOCK_AI=
# 1 이면 Supabase 없이 기기 아이디로 사용자를 구분하고 메모리에 기록해요(서버를 끄면 사라짐)
SOKMAL_DEV_AUTH=

# ---------- 초대 코드 ----------
# 숫자 6자리. 이 코드를 넣은 사람만 앱에 들어올 수 있어요(첫 화면 = 입장 화면). 쉼표로 여러 개. 비워 두면 초대 코드 없이 열려요.
# 같은 접속 주소에서 10분 안에 10번 틀리면 15분 동안 막혀요.
# 고친 뒤에는 Vercel에서 다시 배포해야 반영돼요.
SOKMAL_INVITE_CODES=

# 로그인 (11-28): 배우의 저장소와 같은 Supabase 프로젝트. 공개 값 2개만(비밀 키 service_role 은 넣지 않음).
# 넣으면 초대 코드 대신 "이메일 코드 로그인 → 프로필 → 관리자 승인"이 돼요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 처음부터 승인되는 관리자 이메일(쉼표로)
SOKMAL_OWNER_EMAILS=
# off 로 두면 승인 없이 가입하면 바로 사용 (정식 출시 때)
SOKMAL_APPROVAL=
# 시험용 가짜 로그인(코드 12345678). 배포에서는 절대 켜지 말 것
SOKMAL_FAKE_AUTH=

# ---------- 관리자 페이지 (/admin) ----------
# 관리자 코드 (초대 코드와 별개, 길게). 비워 두면 관리자 페이지가 열리지 않아요.
SOKMAL_ADMIN_CODE=

# ---------- 저장소 (Upstash Redis) ----------
# Vercel → Storage(또는 Marketplace)에서 Upstash Redis를 sokmal-web에 연결하면 Vercel이 자동으로 넣어 줘요. 직접 적지 않아도 돼요.
# KV_REST_API_URL= / KV_REST_API_TOKEN=  (또는 UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=)
